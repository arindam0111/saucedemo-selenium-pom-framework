<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Regression Suite" verbose="1" parallel="classes" thread-count="2">

    <listeners>
        <listener class-name="com.saucedemo.base.TestListener" />
    </listeners>

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression" />
            </run>
        </groups>

        <packages>
            <package name="com.saucedemo.tests" />
        </packages>
    </test>

</suite>